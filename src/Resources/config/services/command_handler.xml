<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <defaults public="true" autoconfigure="false" autowire="false"/>

        <service id="bitbag.payu_plugin.command_handler.capture"
                 class="BitBag\SyliusPayUPlugin\CommandHandler\CapturePayUPaymentRequestHandler"
        >
            <argument type="service" id="Sylius\Bundle\PaymentBundle\Provider\PaymentRequestProviderInterface"/>
            <argument type="service" id="Sylius\Abstraction\StateMachine\StateMachineInterface"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.payu_plugin.api.payu_client_factory"/>
            <argument type="service" id="bitbag.payu_plugin.builder.order_payload"/>
            <argument type="service" id="bitbag.payu_plugin.notification.signature_verifier"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="sylius.repository.payment_request"/>

            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus"/>
        </service>
    </services>
</container>
