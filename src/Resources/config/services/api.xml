<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <defaults public="true" autoconfigure="false" autowire="false"/>

        <service id="bitbag.payu_plugin.api.payu_client_factory"
                 class="BitBag\SyliusPayUPlugin\Api\PayUClientFactory">
            <argument>%bitbag_open_payu_cache_dir%</argument>
        </service>

        <service id="BitBag\SyliusPayUPlugin\Api\PayUClientFactoryInterface"
                 alias="bitbag.payu_plugin.api.payu_client_factory"/>

    </services>
</container>
