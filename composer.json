{
    "name": "bitbag/payu-plugin",
    "type": "sylius-plugin",
    "description": "PayU payment plugin for Sylius applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikołaj Król",
            "email": "mikolaj.krol@bitbag.pl"
        },
        {
            "name": "Patryk Drapik",
            "email": "patryk.drapik@bitbag.pl"
        }
    ],
    "require": {
        "php": "^8.1",
        "sylius/sylius": "~1.14.0",
        "openpayu/openpayu": "^2.2",
        "php-http/message-factory": "^1.1"
    },
    "require-dev": {
        "symfony/webpack-encore-bundle": "^1.15 || ^2.0",
        "behat/behat": "^3.7",
        "behat/mink-selenium2-driver": "~1.6.0",
        "dmore/behat-chrome-extension": "^1.3",
        "dmore/chrome-mink-driver": "^2.7",
        "friends-of-behat/mink": "^1.8",
        "friends-of-behat/mink-browserkit-driver": "^1.4",
        "friends-of-behat/mink-debug-extension": "^2.0",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.1",
        "friends-of-behat/variadic-extension": "^1.3",
        "phpspec/phpspec": "^7.0",
        "phpunit/phpunit": "^9.5",
        "sylius-labs/coding-standard": "^4.1",
        "symfony/browser-kit": "^6.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "vimeo/psalm": "^5.0",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "bitbag/coding-standard": "^3.0"
    },
    "conflict": {
        "doctrine/persistence": "<3.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BitBag\\SyliusPayUPlugin\\": "src/",
            "Tests\\BitBag\\SyliusPayUPlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"]
    },
    "config": {
        "allow-plugins": true
    }
}
