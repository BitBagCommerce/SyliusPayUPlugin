{
    "name": "bitbag/payu-plugin",
    "type": "sylius-plugin",
    "description": "PayU payment plugin for Sylius applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikołaj Król",
            "email": "mikolaj.krol@bitbag.pl"
        },
        {
            "name": "Patryk Drapik",
            "email": "patryk.drapik@bitbag.pl"
        }
    ],
    "require": {
        "sylius/sylius": "^2.0.4",
        "openpayu/openpayu": "^2.2",
        "symfony/webpack-encore-bundle": "^2.1"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "behat/mink-selenium2-driver": "^1.6",
        "bitbag/coding-standard": "^3.0",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-doctrine": "1.3.40",
        "phpstan/phpstan-strict-rules": "^1.3.0",
        "phpstan/phpstan-webmozart-assert": "^1.2.0",
        "phpunit/phpunit": "^9.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "sylius/mailer-bundle":  "^1.8 || ^2.0@beta",
        "sylius-labs/coding-standard": "^4.4",
        "symfony/browser-kit": "^6.4 || ^7.1",
        "symfony/debug-bundle": "^6.4 || ^7.1",
        "symfony/dotenv": "^6.4 || ^7.1",
        "symfony/flex": "^2.4",
        "symfony/intl": "^6.4 || ^7.1",
        "symfony/web-profiler-bundle": "^6.4 || ^7.1",
        "nyholm/psr7": "^1.8"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BitBag\\SyliusPayUPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\BitBag\\SyliusPayUPlugin\\": [
                "tests/",
                "tests/Application/src"
            ]
        },
        "classmap": ["tests/Application/Kernel.php"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    },
    "extra": {
        "symfony": {
            "require": "^6.4 || ^7.1"
        }
    }
}
